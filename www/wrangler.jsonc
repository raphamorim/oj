{
  "name": "oj-docs",
  "main": "dist/worker.mjs",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "vars": {
    "SITE_NAME": "oj"
  }
}
